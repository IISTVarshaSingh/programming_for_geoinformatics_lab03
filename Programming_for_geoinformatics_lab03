import cv2
import numpy as np
import matplotlib.pyplot as plt
# OPEN CV IMAGE PROCESSING ASSIGNMENT


# Image load
img = cv2.imread("image.jpg")

if img is None:
    print("Error: image.jpg not found")
    exit()


image_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)



# 1. LOAD RGB IMAGE AND VISUALIZE


plt.figure(figsize=(6, 5))
plt.imshow(image_rgb)
plt.title("1. Original RGB Image")
plt.axis("off")
plt.show()



# 2. MEAN, STANDARD DEVIATION AND NORMALIZATION


mean = np.mean(image_rgb, axis=(0, 1))
std = np.std(image_rgb, axis=(0, 1))

print("\n========== QUESTION 2 ==========")

print("Mean of Red Channel   :", mean[0])
print("Mean of Green Channel :", mean[1])
print("Mean of Blue Channel  :", mean[2])

print("\nStandard Deviation")
print("Red Channel   :", std[0])
print("Green Channel :", std[1])
print("Blue Channel  :", std[2])

# Normalize:
# (pixel - channel mean) / channel standard deviation

normalized = (
    image_rgb.astype(np.float32) - mean
) / std

# For visualization, convert normalized values to 0-255
normalized_display = cv2.normalize(
    normalized,
    None,
    0,
    255,
    cv2.NORM_MINMAX
).astype(np.uint8)

plt.figure(figsize=(6, 5))
plt.imshow(normalized_display)
plt.title("2. Normalized Image")
plt.axis("off")
plt.show()



# 3. DIMENSIONS, DATA TYPE AND TOTAL PIXELS


height, width, channels = image_rgb.shape

print("\n========== QUESTION 3 ==========")

print("Height   :", height)
print("Width    :", width)
print("Channels :", channels)
print("Data Type:", image_rgb.dtype)
print("Total Pixels:", height * width)



# 4. IMAGE CROPPING


#  small region of center of Image
y1 = height // 4
y2 = height // 2

x1 = width // 4
x2 = width // 2

crop = image_rgb[y1:y2, x1:x2]

plt.figure(figsize=(5, 4))
plt.imshow(crop)
plt.title("4. Cropped Image")
plt.axis("off")
plt.show()



# 5. SPLIT IMAGE INTO FOUR EQUAL PARTS


#  make  the  dimensions even for equal division
h = height - height % 2
w = width - width % 2

image_even = image_rgb[:h, :w]

# Four parts

top_left = image_even[:h//2, :w//2]

top_right = image_even[:h//2, w//2:]

bottom_left = image_even[h//2:, :w//2]

bottom_right = image_even[h//2:, w//2:]


# Visualize four parts

plt.figure(figsize=(8, 6))

plt.subplot(2, 2, 1)
plt.imshow(top_left)
plt.title("Top Left")
plt.axis("off")

plt.subplot(2, 2, 2)
plt.imshow(top_right)
plt.title("Top Right")
plt.axis("off")

plt.subplot(2, 2, 3)
plt.imshow(bottom_left)
plt.title("Bottom Left")
plt.axis("off")

plt.subplot(2, 2, 4)
plt.imshow(bottom_right)
plt.title("Bottom Right")
plt.axis("off")

plt.suptitle("5. Four Equal Parts")
plt.tight_layout()
plt.show()


# Merge four parts

top = np.hstack((top_left, top_right))
bottom = np.hstack((bottom_left, bottom_right))

merged = np.vstack((top, bottom))

plt.figure(figsize=(6, 5))
plt.imshow(merged)
plt.title("5. Merged Image")
plt.axis("off")
plt.show()



# 6. HISTOGRAM OF EACH COLOR CHANNEL

plt.figure(figsize=(8, 5))

colors = ["Red", "Green", "Blue"]

for i, color in enumerate(colors):

    histogram = cv2.calcHist(
        [image_rgb],
        [i],
        None,
        [256],
        [0, 256]
    )

    plt.plot(histogram, label=color)

plt.title("6. RGB Color Channel Histogram")
plt.xlabel("Pixel Intensity")
plt.ylabel("Frequency")
plt.legend()
plt.xlim([0, 256])
plt.show()




gray = cv2.cvtColor(
    image_rgb,
    cv2.COLOR_RGB2GRAY
)

# Grayscale image

plt.figure(figsize=(6, 5))
plt.imshow(gray, cmap="gray")
plt.title("7. Grayscale Image")
plt.axis("off")
plt.show()


# Grayscale histogram

gray_histogram = cv2.calcHist(
    [gray],
    [0],
    None,
    [256],
    [0, 256]
)

plt.figure(figsize=(8, 5))
plt.plot(gray_histogram)
plt.title("7. Grayscale Histogram")
plt.xlabel("Pixel Intensity")
plt.ylabel("Frequency")
plt.xlim([0, 256])
plt.show()




# Zoom in 2x

zoom_in = cv2.resize(
    image_rgb,
    None,
    fx=2,
    fy=2,
    interpolation=cv2.INTER_LINEAR
)

# Zoom out 2x

zoom_out = cv2.resize(
    image_rgb,
    None,
    fx=0.5,
    fy=0.5,
    interpolation=cv2.INTER_AREA
)


# Side by side visualization

plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.imshow(zoom_in)
plt.title("8. Zoom In 2x")
plt.axis("off")

plt.subplot(1, 2, 2)
plt.imshow(zoom_out)
plt.title("8. Zoom Out 2x")
plt.axis("off")

plt.tight_layout()
plt.show()


# Shapes

print("\n========== QUESTION 8 ==========")

print("Original Shape :", image_rgb.shape)
print("Zoom In Shape  :", zoom_in.shape)
print("Zoom Out Shape :", zoom_out.shape)




pyramid1 = cv2.pyrDown(image_rgb)

pyramid2 = cv2.pyrDown(pyramid1)

pyramid3 = cv2.pyrDown(pyramid2)


# Visualize pyramid

plt.figure(figsize=(10, 8))

plt.subplot(2, 2, 1)
plt.imshow(image_rgb)
plt.title("Original")
plt.axis("off")

plt.subplot(2, 2, 2)
plt.imshow(pyramid1)
plt.title("Pyramid Level 1")
plt.axis("off")

plt.subplot(2, 2, 3)
plt.imshow(pyramid2)
plt.title("Pyramid Level 2")
plt.axis("off")

plt.subplot(2, 2, 4)
plt.imshow(pyramid3)
plt.title("Pyramid Level 3")
plt.axis("off")

plt.suptitle("9. Image Pyramid using cv2.pyrDown()")
plt.tight_layout()
plt.show()


# Pyramid shapes

print("\n========== QUESTION 9 ==========")

print("Original Shape :", image_rgb.shape)
print("Level 1 Shape  :", pyramid1.shape)
print("Level 2 Shape  :", pyramid2.shape)
print("Level 3 Shape  :", pyramid3.shape)



